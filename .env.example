# Configure these as Apache/PHP environment variables before enabling email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-new-gmail-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com
SMTP_FROM_NAME=StayExplore Kenya
APP_BASE_URL=http://localhost/smart_accommodation
